# Local development variables for `wrangler dev`.
#
# Copy to `worker/.dev.vars` (git-ignored) and replace every value.
# `worker/.dev.vars` is read by wrangler only — never committed.
#
# Generate a JWT secret:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"

# REQUIRED — signs access tokens (>= 32 characters). The API returns 503 for
# authenticated routes when it is missing or too short.
JWT_SECRET="replace-with-a-48-byte-random-value"

# REQUIRED in practice — comma separated browser origins for CORS.
ALLOWED_ORIGINS="http://localhost:5173"

# Optional — Cloudflare Turnstile (abuse protection on register/login).
# Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Optional — creates the first administrator while no admin exists.
# BOOTSTRAP_ADMIN_EMAIL="owner@example.com"

# Optional — provider defaults.
R2_DEFAULT_REGION="auto"
STREAM_MODE="auto"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"

# Optional — PBKDF2 iterations. 210000 is recommended; lower it only for tests.
# PASSWORD_HASH_ITERATIONS="210000"

# ---------------------------------------------------------------------------
# Credentials for providers registered through /api/admin/storage with
# authMode = "credentials". The credential reference "secondary" maps to these
# names. The R2 binding provider (MUSIC_BUCKET) needs none of them.
# ---------------------------------------------------------------------------
# R2_SECONDARY_ACCESS_KEY_ID=""
# R2_SECONDARY_SECRET_ACCESS_KEY=""
# R2_SECONDARY_SESSION_TOKEN=""
