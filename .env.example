# AETHER front-end configuration (Vite)
#
# Copy to `.env.local` (git-ignored) for local overrides. Vite only exposes
# variables prefixed with VITE_ to the browser — never put a secret here.
#
# The API is called on the same origin by default: the Vite dev server proxies
# /api to the Worker (see vite.config.ts), and in production the dashboard is
# served from the same origin as the API or configured with a base URL below.

# Where the browser sends API requests. Leave empty for same-origin.
VITE_API_BASE_URL=""

# Dev-server proxy target for /api (defaults to http://127.0.0.1:8787).
VITE_WORKER_ORIGIN=""

# ---------------------------------------------------------------------------
# Reference: Worker-side configuration (set with wrangler, not Vite).
#
#   npx wrangler secret put JWT_SECRET            --config worker/wrangler.toml
#   npx wrangler secret put TURNSTILE_SECRET_KEY  --config worker/wrangler.toml
#   npx wrangler secret put BOOTSTRAP_ADMIN_EMAIL --config worker/wrangler.toml
#   npx wrangler secret put R2_<REF>_ACCESS_KEY_ID     --config worker/wrangler.toml
#   npx wrangler secret put R2_<REF>_SECRET_ACCESS_KEY --config worker/wrangler.toml
#
# Non-secret values (ALLOWED_ORIGINS, STREAM_MODE, ...) live in worker/wrangler.toml.
# ---------------------------------------------------------------------------
